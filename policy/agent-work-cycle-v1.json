{
  "schema": "rozkalns.agent-work-cycle.v1",
  "status": "ACTIVE",
  "canonical_repository": "rozkalnsandris/ops-workflows",
  "reference_repository": "rozkalnsandris/RPi5_main",
  "umbrella_issue": 31,
  "canonical_commands": {
    "start": "START <repo>",
    "sync": "SYNC <repo>",
    "continue": "turpini"
  },
  "retrieval": {
    "start_mode": "MINIMUM_SUFFICIENT",
    "sync_mode": "INCREMENTAL",
    "single_current_lane": true,
    "repo_wide_audit_by_default": false,
    "historical_ci_comments_reviews_by_default": false,
    "demand_driven_expansion": true
  },
  "execution": {
    "start_auto_continues_safe_same_scope_work": true,
    "start_must_not_stop_after_reporting_immediately_executable_safe_step": true,
    "sync_refreshes_selected_lane_only": true,
    "continue_preserves_exact_scope": true,
    "audit_handoff_is_explicit_deep_mode": true,
    "safe_technical_steps_create_owner_gate": false,
    "safe_technical_steps": [
      "MINIMUM_SUFFICIENT_GITHUB_READS",
      "SOURCE_INSPECTION",
      "FOCUSED_SOURCE_DOCS_POLICY_EDITS",
      "LOCAL_OR_STATIC_TESTS",
      "AUTHORIZED_BRANCH_OR_PR_PREPARATION",
      "EXACT_HEAD_CI_REVIEW_REFRESH",
      "SCOPE_PRESERVING_CORRECTION_WITHIN_ATTEMPT_BUDGET",
      "READ_ONLY_PREFLIGHT_OR_EVIDENCE_REFRESH",
      "EXACT_MAIN_READ_ONLY_RECONCILIATION"
    ],
    "terminal_conditions": [
      "GENUINE_OWNER_GATE",
      "EXTERNAL_WAIT_WITH_NO_SAFE_ADVANCE",
      "FAIL_CLOSED_ERROR_DRIFT_OR_AMBIGUITY",
      "DONE"
    ],
    "full_mode_issue_scoped_authority_must_not_gain_extra_generic_gate": true,
    "live_requirement_stops_before_live_mutation_without_exact_authority": true
  },
  "tool_transport_priority": {
    "default_surface": "GITHUB",
    "prefer_connected_github_for_github_native_work": true,
    "rdc_or_host_shell_only_when_host_local_execution_or_observation_is_required": true,
    "rdc_must_not_substitute_for_supported_github_native_operations": true,
    "mixed_surface_order": [
      "GITHUB",
      "MINIMAL_REQUIRED_HOST_STEP",
      "GITHUB"
    ],
    "rdc_is_execution_transport_not_source_or_authorization_authority": true,
    "rdc_never_widens_authorization": true
  },
  "owner_gates": {
    "merge_explicit_by_default": true,
    "repo_local_explicit_full_mode_may_freeze_issue_scoped_merge_authority": true,
    "merge_never_implies_live": true,
    "live_uses_repo_local_exact_authorization": true,
    "authorization_consumed_at_first_authorized_mutation": true,
    "post_mutation_uncertainty_fail_closed": true,
    "automatic_retry_rollback_cleanup": false
  },
  "response_contract": {
    "compact_terminal_response_required": true,
    "normal_field_order": [
      "STATE",
      "EVIDENCE",
      "DONE",
      "NOT_DONE_OR_BLOCKER",
      "FINAL_COMMAND"
    ],
    "evidence_max_decisive_facts": 4,
    "omit_empty_optional_fields": true,
    "action_required_only_for_genuine_owner_gate": true,
    "safe_continuation_must_run_before_terminal_response_when_immediately_available": true,
    "turpini_only_when_execution_boundary_pauses_with_same_scope_safe_work_remaining": true,
    "long_history_replay_by_default": false
  },
  "next_command_contract": {
    "required_on_every_user_visible_work_cycle_terminal_response": true,
    "exactly_one_recommended_command": true,
    "command_must_be_copy_pasteable": true,
    "command_must_be_last_actionable_content": true,
    "action_required_reserved_for_real_owner_gate": true,
    "do_not_invent_owner_gate": true,
    "selection_order": [
      "EXACT_OWNER_AUTHORIZATION_IF_REAL_GATE_EXISTS",
      "SYNC_REPO_WHEN_WAITING_ON_MUTABLE_GITHUB_OR_EXTERNAL_STATE",
      "TURPINI_WHEN_EXECUTION_BOUNDARY_PAUSES_WITH_SAFE_SAME_SCOPE_WORK_REMAINING",
      "START_REPO_WHEN_CURRENT_OUTCOME_IS_DONE"
    ],
    "never_implies_merge_or_live_authority": true
  },
  "rollout_repositories": [
    "rozkalnsandris/ops-workflows",
    "rozkalnsandris/RPi5_main",
    "rozkalnsandris/hermes-deals",
    "rozkalnsandris/hermes-tech",
    "rozkalnsandris/rozkalns-cv",
    "rozkalnsandris/rozkalns-control-center",
    "rozkalnsandris/dashboard_RPi5",
    "rozkalnsandris/RPi5-maintenance",
    "rozkalnsandris/home-assistant-config",
    "rozkalnsandris/balcony-irrigation-esp32",
    "rozkalnsandris/rozkalns_weather",
    "rozkalnsandris/linux-operations-lab"
  ],
  "explicit_exclusions": [
    "rozkalnsandris/deploy-authorizations",
    "rozkalnsandris/hermes-email-skill",
    "rozkalnsandris/YouTube_Marcim",
    "rozkalnsandris/rozkalnsandris"
  ],
  "repo_local_stricter_rules_win": true
}
