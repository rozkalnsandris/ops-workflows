{
  "schema_version": 1,
  "policy": "DEPENDENCY_WORKFLOW_HARDENING_V1",
  "canonical_repository": "rozkalnsandris/ops-workflows",
  "status": "SOURCE_GUARDS_ACTIVE_RENOVATE_APP_OWNER_GATED",
  "renovate": {
    "enabled_managers": [
      "github-actions"
    ],
    "hosted_app_install_requires_owner_repository_permission_action": true,
    "automerge": false,
    "platform_automerge": false,
    "dependency_dashboard": true,
    "dependency_dashboard_approval_default": true,
    "pr_creation": "immediate",
    "vulnerability_alerts": false,
    "branch_concurrent_limit": 2,
    "pr_concurrent_limit": 2,
    "pr_hourly_limit": 1,
    "commit_hourly_limit": 2,
    "major_updates_require_dashboard_approval": true,
    "major_update_types": [
      "major"
    ],
    "dashboard_bypass_update_types": [
      "digest",
      "patch",
      "minor"
    ],
    "github_runner_updates_enabled": false,
    "github_runner_dep_type": "github-runner",
    "zizmor_action_renovate_updates_enabled": false,
    "zizmor_action_package": "zizmorcore/zizmor-action"
  },
  "workflow_static_analysis": {
    "reusable_workflow": ".github/workflows/workflow-security.yml",
    "permissions": {
      "contents": "read"
    },
    "self_hosted_runner": false,
    "secrets_inherit": false,
    "actionlint": {
      "version": "1.7.12",
      "linux_amd64_archive_sha256": "8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8"
    },
    "zizmor": {
      "action_sha": "3dc1ecc9bcb9e94e9b2c709687979e1298497054",
      "action_version": "v0.6.2",
      "engine_version": "1.29.0",
      "renovate_update_mode": "manual_companion_contract",
      "online_audits": false,
      "advanced_security": false,
      "annotations": true,
      "auto_fix": false
    }
  },
  "boundaries": {
    "shared_workflow_mutates_repository": false,
    "shared_workflow_mutates_runtime": false,
    "shared_workflow_inherits_secrets": false,
    "renovate_pr_is_merge_authority": false,
    "renovate_app_install_is_source_change": false,
    "merge_authorizes_live": false,
    "repository_local_stricter_rules_win": true
  }
