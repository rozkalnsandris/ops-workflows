{
  "schema": "rozkalns.github-api-access.v1",
  "status": "ACTIVE_SHARED_GOVERNANCE",
  "canonical_repository": "rozkalnsandris/ops-workflows",
  "tracking": {
    "umbrella_issue": 108,
    "contract_issue": 109,
    "read_plan_issue": 110,
    "mutation_boundary_issue": 111
  },
  "authority": {
    "github_is_canonical_mutable_state_source": true,
    "repo_local_stricter_rules_win": true,
    "changes_merge_authority": false,
    "changes_live_authority": false,
    "changes_deploy_authority": false,
    "creates_mutation_retry_authority": false
  },
  "access": {
    "authenticated_preferred_when_supported": true,
    "serial_by_default_per_repository_lane": true,
    "parallel_fanout_by_default": false,
    "minimum_sufficient_retrieval_required": true,
    "reuse_same_step_evidence_when_sufficient": true,
    "event_or_state_driven_continuation_preferred": true,
    "tight_polling_allowed": false,
    "honor_poll_interval_when_exposed": true,
    "conditional_requests_when_transport_supports": true,
    "pretend_conditional_support_when_unavailable": false,
    "continuous_rate_limit_endpoint_polling": false,
    "quota_evasion_allowed": false
  },
  "request_budget_classes": [
    "BOOTSTRAP_MINIMAL",
    "PR_REFRESH_COMPACT",
    "PR_FILES_ON_DEMAND",
    "FINAL_PREMERGE_COMPACT",
    "EXACT_MAIN_MINIMAL",
    "DEEP_AUDIT_EXPLICIT"
  ],
  "lane_read_plans": {
    "START_PR": {
      "budget_class": "BOOTSTRAP_MINIMAL",
      "facts": [
        "REPOSITORY_RULES",
        "CANONICAL_CONTINUATION_WHEN_NEEDED",
        "CURRENT_MAIN_SHA",
        "CURRENT_ISSUE_OR_PR_IDENTITY",
        "EXACT_PR_HEAD",
        "REQUIRED_CHECKS_OR_STATUS",
        "REVIEWS",
        "UNRESOLVED_REVIEW_THREADS"
      ],
      "default_exclusions": [
        "UNRELATED_ISSUES_OR_PRS",
        "HISTORICAL_WORKFLOW_RUNS",
        "ALL_CHANGED_FILES",
        "ALL_COMMENTS",
        "ALL_COMMITS",
        "REPO_WIDE_INVENTORY"
      ]
    },
    "SYNC_OR_CONTINUE_PR": {
      "budget_class": "PR_REFRESH_COMPACT",
      "facts": [
        "CURRENT_MAIN_SHA_WHEN_RELEVANT",
        "EXACT_PR_HEAD",
        "REQUIRED_CHECKS_OR_STATUS",
        "REVIEWS",
        "UNRESOLVED_REVIEW_THREADS"
      ],
      "refresh_selected_lane_only": true,
      "historical_workflow_runs_by_default": false,
      "comments_by_default": false,
      "changed_files_by_default": false
    },
    "PR_FILES": {
      "budget_class": "PR_FILES_ON_DEMAND",
      "enumerate_only_when_file_level_evidence_is_required": true,
      "one_paginated_listing_per_stable_head_when_sufficient": true,
      "fetch_per_file_patch_only_when_needed": true,
      "refetch_unchanged_file_list_during_ci_review_refresh": false
    },
    "DEEP_AUDIT": {
      "budget_class": "DEEP_AUDIT_EXPLICIT",
      "explicit_mode_required": true,
      "duplicate_reads_still_forbidden": true,
      "pagination_must_remain_bounded": true
    }
  },
  "ci_review_refresh": {
    "event_state_transition_or_user_continuation_preferred": true,
    "tight_loop_allowed": false,
    "exact_head_evidence_only_by_default": true,
    "unrelated_historical_runs_by_default": false,
    "prefer_aggregate_connector_operation_when_equivalent": true,
    "reuse_same_state_response_when_sufficient": true
  },
  "connector_capabilities": {
    "conditional_request_headers_may_be_unavailable": true,
    "graphql_may_be_unavailable": true,
    "typed_aggregate_operations_preferred_when_equivalent": true,
    "must_not_invent_unexposed_capability": true
  },
  "pagination": {
    "api_provided_pagination_required": true,
    "unbounded_normal_lane_scan_allowed": false
  },
  "graphql": {
    "optional": true,
    "use_only_when_total_request_cost_is_reduced": true,
    "request_only_needed_fields": true,
    "connection_first_last_min": 1,
    "connection_first_last_max": 100,
    "single_query_node_limit": 500000,
    "deep_unbounded_query_allowed": false,
    "cursor_pagination_required_when_needed": true
  },
  "rate_limit_dispositions": [
    "PRIMARY_RATE_LIMIT_EXHAUSTED",
    "SECONDARY_RATE_LIMIT_SUSPECTED",
    "RETRY_AFTER_REQUIRED",
    "RESET_WAIT_REQUIRED",
    "READ_BACKOFF_REQUIRED",
    "TRANSPORT_RATE_LIMIT_METADATA_UNAVAILABLE"
  ],
  "read_backoff": {
    "only_before_first_authorized_mutation": true,
    "retry_after_has_priority": true,
    "remaining_zero_wait_for_reset": true,
    "secondary_without_retry_after_min_wait_seconds": 60,
    "repeated_secondary_uses_bounded_exponential_backoff": true,
    "busy_loop_allowed": false,
    "parallel_alternate_endpoint_probe_allowed": false,
    "must_obey_repo_local_stricter_attempt_limit": true
  },
  "read_path_interrupt": {
    "rate_limit_or_backoff_may_pause_or_stop_read_path": true,
    "interruption_may_widen_authority": false,
    "interruption_may_trigger_unrelated_state_scan": false
  },
  "mutation_outcome_dispositions": [
    "MUTATION_CONFIRMED_SUCCESS",
    "MUTATION_CONFIRMED_REJECTED_BEFORE_APPLY",
    "MUTATION_OUTCOME_UNKNOWN_RATE_LIMIT",
    "MUTATION_OUTCOME_UNKNOWN_TIMEOUT",
    "MUTATION_OUTCOME_UNKNOWN_TRANSPORT",
    "POST_MUTATION_RECONCILIATION_REQUIRED"
  ],
  "mutation_boundary": {
    "final_pre_mutation_budget_class": "FINAL_PREMERGE_COMPACT",
    "final_pre_mutation_facts": [
      "CURRENT_MAIN_OR_BASE",
      "EXACT_PR_HEAD",
      "MERGEABILITY",
      "REQUIRED_EXACT_HEAD_CI_OR_STATUS",
      "REVIEWS",
      "UNRESOLVED_REVIEW_THREADS",
      "EXACT_AUTHORITY_BINDING"
    ],
    "broad_repo_audit_before_mutation_allowed": false,
    "expected_head_binding_required_when_supported": true,
    "authorization_consumed_when_mutation_dispatched": true,
    "automatic_duplicate_mutation_after_403": false,
    "automatic_duplicate_mutation_after_429": false,
    "automatic_duplicate_mutation_after_timeout": false,
    "automatic_duplicate_mutation_after_transport_error": false,
    "automatic_duplicate_mutation_after_malformed_or_partial_response": false,
    "rate_limit_handling_may_create_mutation_authority": false,
    "post_dispatch_uncertainty_fail_closed": true,
    "http_429_proves_mutation_not_applied": false,
    "alternate_endpoint_or_tool_retry_after_dispatch_allowed": false,
    "rollback_cleanup_rebase_reset_after_ambiguity_allowed": false,
    "minimal_read_only_reconciliation_only": true,
    "stop_after_ambiguous_outcome": true,
    "merge_success_implies_live_or_deploy_authority": false
  },
  "post_mutation_reconciliation": {
    "same_run_read_only_evidence_when_permitted": [
      "PR_MERGED_STATE",
      "CURRENT_MAIN_SHA"
    ],
    "rate_limit_blocks_evidence_then_stop_without_probe": true,
    "next_sync_requires_fresh_canonical_reconciliation": true,
    "expected_head_merged_and_lineage_correct": "MUTATION_CONFIRMED_SUCCESS",
    "expected_head_not_merged_consumed_authority_revives": false,
    "expected_head_not_merged_requires_fresh_authority": true,
    "ambiguous_or_drifted_state_remains_stopped": true,
    "confirmed_success_budget_class": "EXACT_MAIN_MINIMAL",
    "confirmed_success_deep_audit_by_default": false,
    "deeper_retrieval_only_on_verification_failure_or_drift": true
  },
  "mutation_scenarios": {
    "EXACT_HEAD_GUARDED_SUCCESS": {
      "mutation_dispatched": true,
      "disposition": "MUTATION_CONFIRMED_SUCCESS",
      "automatic_duplicate_mutation_allowed": false,
      "post_result_budget_class": "EXACT_MAIN_MINIMAL"
    },
    "HEAD_DRIFT_PRE_DISPATCH": {
      "mutation_dispatched": false,
      "disposition": "MUTATION_CONFIRMED_REJECTED_BEFORE_APPLY",
      "automatic_duplicate_mutation_allowed": false
    },
    "PRIMARY_RATE_LIMIT_PRE_DISPATCH": {
      "mutation_dispatched": false,
      "read_backoff_may_apply": true,
      "automatic_duplicate_mutation_allowed": false
    },
    "HTTP_429_POST_DISPATCH": {
      "mutation_dispatched": true,
      "disposition": "MUTATION_OUTCOME_UNKNOWN_RATE_LIMIT",
      "automatic_duplicate_mutation_allowed": false,
      "requires_reconciliation": true
    },
    "TIMEOUT_POST_DISPATCH": {
      "mutation_dispatched": true,
      "disposition": "MUTATION_OUTCOME_UNKNOWN_TIMEOUT",
      "automatic_duplicate_mutation_allowed": false,
      "requires_reconciliation": true
    },
    "TRANSPORT_ERROR_POST_DISPATCH": {
      "mutation_dispatched": true,
      "disposition": "MUTATION_OUTCOME_UNKNOWN_TRANSPORT",
      "automatic_duplicate_mutation_allowed": false,
      "requires_reconciliation": true
    },
    "NEXT_SYNC_PROVES_APPLIED": {
      "disposition": "MUTATION_CONFIRMED_SUCCESS",
      "automatic_duplicate_mutation_allowed": false,
      "fresh_authority_required": false
    },
    "NEXT_SYNC_PROVES_NOT_APPLIED": {
      "disposition": "POST_MUTATION_RECONCILIATION_REQUIRED",
      "automatic_duplicate_mutation_allowed": false,
      "fresh_authority_required": true
    }
  },
  "forbidden_evasion": [
    "TOKEN_ROTATION_FOR_QUOTA_EVASION",
    "ACCOUNT_ROTATION_FOR_QUOTA_EVASION",
    "IP_ROTATION_FOR_QUOTA_EVASION",
    "ENDPOINT_SWITCHING_TO_BYPASS_ENFORCEMENT"
  ]
}
