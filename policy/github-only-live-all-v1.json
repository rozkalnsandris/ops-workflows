{
  "schema_version": 2,
  "policy": "GITHUB-ONLY / LIVE-ALL v1",
  "canonical_repository": "rozkalnsandris/ops-workflows",
  "accepted_date": "2026-08-25",
  "amended_date": "2026-08-26",
  "adoption_version": "2026-08-26.1",
  "inherits": "FAST-LANE v2.2 Composite",
  "precedence": "repository_local_stricter_trust_boundary_rules_win",
  "startup_contract": "docs/START_GITHUB_ONLY_V1.md",
  "startup_manifest_schema": "policy/schemas/start-github-only-v1.schema.json",
  "consumer_baseline": "policy/github-only-consumer-baseline.json",
  "live_entrypoint_inventory": "policy/live-entrypoints-v1.json",
  "executor_capability_inventory": "policy/executor-capabilities-v1.json",
  "commands": {
    "github_only": {
      "canonical": "GITHUB-ONLY",
      "accepted_aliases": ["git hub only"],
      "persists_until": ["LIVE-ALL_COMPLETES_OR_STOPS", "EXPLICIT_MODE_CANCEL"],
      "activation": {
        "requires_explicit_mode_token_when_inactive": true,
        "plain_start_activates_github_only": false,
        "direct_commands": ["GITHUB-ONLY", "git hub only"],
        "start_forms": [
          "START <repository> GITHUB-ONLY",
          "START <repository> git hub only"
        ],
        "infer_from_policy_presence": false,
        "infer_from_manifest_presence": false,
        "infer_from_repository_adoption": false,
        "infer_from_prior_conversation": false,
        "already_active_plain_start_preserves_mode": true
      },
      "allows": [
        "FRESH_GITHUB_STATE_READ",
        "SOURCE_LEVEL_IMPLEMENTATION",
        "ISSUE_BRANCH_COMMIT_PUSH_PR",
        "CI_REVIEW_AND_BOUNDED_CORRECTIONS",
        "POST_MERGE_READ_ONLY_EVIDENCE_AFTER_SEPARATE_MERGE_AUTH",
        "DEPLOY_PREPARATION_UP_TO_FIRST_LIVE_MUTATION",
        "DEPLOY_QUEUE_CREATE_OR_UPDATE"
      ],
      "forbids": [
        "MERGE_WITHOUT_SEPARATE_EXPLICIT_AUTHORIZATION",
        "PRODUCTION_DEPLOY_OR_PUBLISH",
        "PRODUCTION_HOST_CONTAINER_SERVICE_DEVICE_MUTATION",
        "PRODUCTION_DATABASE_WRITE_OR_MIGRATION",
        "CLOUDFLARE_DNS_TUNNEL_ACCESS_MUTATION",
        "SECRET_CREDENTIAL_PERMISSION_TRUST_BOUNDARY_CHANGE",
        "DESTRUCTIVE_CLEANUP",
        "GITHUB_WRITE_WITH_DETERMINISTIC_FORBIDDEN_LIVE_SIDE_EFFECT",
        "DIRECT_DEFAULT_BRANCH_CONTENT_WRITE"
      ],
      "start_bootstrap": {
        "deterministic": true,
        "step_count": 10,
        "steps": [
          "RESOLVE_CANONICAL_REPOSITORY_AND_MODE",
          "LOAD_LOCAL_AUTHORITY",
          "LOAD_SHARED_POLICY_AND_VALIDATE_ADOPTION",
          "SNAPSHOT_DEFAULT_BRANCH_AND_GOVERNANCE",
          "INSPECT_AND_NORMALIZE_ACTIVE_PRS",
          "INSPECT_ISSUES_HANDOFF_ROADMAP_DEPENDENCIES",
          "INSPECT_DEPLOY_QUEUE_INDEPENDENT_OF_EXECUTOR",
          "SELECT_CANONICAL_LANE",
          "EXECUTE_BOUNDED_SAFE_SOURCE_WORK_WITH_JIT_REVALIDATION",
          "ROUTE_FINAL_STATE"
        ],
        "read_repository_rules_first": true,
        "read_shared_policy_and_start_contract": true,
        "refresh_default_branch": true,
        "inspect_active_prs": true,
        "inspect_active_issues_master_handoff_and_dependencies": true,
        "inspect_relevant_deploy_queue": true,
        "continue_highest_priority_canonical_safe_lane": true,
        "open_issue_required": false,
        "invent_speculative_work_when_idle": false,
        "stop_when_no_canonical_safe_continuation": "IDLE",
        "jit_revalidation_before_state_dependent_github_mutation": true
      },
      "continuation": {
        "default_precedence": [
          "explicit_current_handoff",
          "active_focused_pr_blocking_current_phase",
          "active_issue_declared_as_current",
          "deploy_queue_source_reconciliation",
          "explicitly_ordered_next_roadmap_item"
        ],
        "default_tie_breakers": ["explicit_phase_priority", "explicit_dependency_order"],
        "forbid_implicit_api_order_tie_break": true,
        "forbid_implicit_issue_number_tie_break": true,
        "unresolved_tie_result": "AMBIGUOUS_CANONICAL_LANE",
        "excluded_candidate_labels": ["automation-fixture", "do-not-merge", "superseded", "parked-historical"]
      },
      "final_state_router": [
        "READY_FOR_MERGE",
        "PARKED",
        "STOP_ERROR",
        "NEW_SCOPE_OR_RISK",
        "AMBIGUOUS_CANONICAL_LANE",
        "IDLE"
      ],
      "parked_session": {
        "is_queue_state": false,
        "when_ready_live_work_is_deferred": "PARKED_NO_ACTION_REQUIRED_NOW",
        "must_not_pressure_immediate_live_all": true
      }
    },
    "live_all": {
      "canonical": "LIVE-ALL",
      "authorization_type": "BATCH_COMPOSITE_LIVE_FOR_FROZEN_EXECUTABLE_READY_QUEUE_SNAPSHOT",
      "executor_capability_check_before_snapshot": true,
      "executor_capability_check_is_read_only": true,
      "freeze_only_ready_items_executable_in_current_session": true,
      "ready_but_executor_unavailable_items_remain_ready": true,
      "no_executable_ready_items_means_no_mutation_and_no_live_authorization_consumption": true,
      "validate_dependency_dag_and_target_conflicts_before_snapshot": true,
      "does_not_authorize": [
        "MERGE",
        "PRODUCTION_DATABASE_WRITE_OR_MIGRATION",
        "SECRETS_OR_CREDENTIALS",
        "PERMISSION_OR_TRUST_BOUNDARY_EXPANSION",
        "DESTRUCTIVE_CLEANUP",
        "CLOUDFLARE_DNS_TUNNEL_ACCESS_MUTATION",
        "UNDECLARED_OR_EXTRA_RISK_CLASS"
      ]
    }
  },
  "queue": {
    "transport": "GITHUB_ISSUE",
    "repository": "rozkalnsandris/ops-workflows",
    "visibility": "public",
    "title_prefix": "[DEPLOY-QUEUE]",
    "open_queue_states": ["WAITING", "READY", "BLOCKED", "EXECUTING", "STOP_ERROR"],
    "terminal_outcomes": ["DONE", "CANCELLED"],
    "parked_is_session_state_not_queue_state": true,
    "executor_availability_is_session_capability_not_queue_readiness": true,
    "executor_unavailable_alone_must_not_change_ready_to_blocked": true,
    "blocked_requires_rollout_eligibility_or_contract_failure": true,
    "blocked_reason_required": true,
    "blocked_reason_enum": [
      "APPROVED_SOURCE_SHA_NO_LONGER_INTENDED",
      "TARGET_OR_REQUIRED_BASELINE_CONFLICT",
      "DEPENDENCY_INCOMPLETE_OR_FAILED",
      "REQUIRED_CI_REVIEW_OR_POST_MERGE_EVIDENCE_INVALID",
      "REVIEWED_ENTRYPOINT_MISSING_OR_INCOMPATIBLY_CHANGED",
      "NEW_SEPARATELY_GATED_OR_UNDECLARED_MUTATION_CATEGORY_REQUIRED",
      "CANDIDATE_TARGET_OR_POLICY_DRIFT_MAKES_ROLLOUT_INELIGIBLE"
    ],
    "snapshot_selects_only": "OPEN_READY_EXECUTABLE_DEPENDENCY_VALID_CONFLICT_FREE_AT_LIVE_ALL_START",
    "ready_but_executor_unavailable_after_capability_check": "LEAVE_READY_AND_REPORT_PARKED_NOT_SELECTED",
    "new_ready_items_after_snapshot_are_excluded": true,
    "one_coherent_rollout_per_issue": true,
    "sequential_by_default": true,
    "same_target_concurrency_allowed": false,
    "same_target_requires_explicit_order": true,
    "dependency_graph_must_be_acyclic": true,
    "dependency_cycle_result": "STOP_NO_MUTATION",
    "eligibility_checked_at_required_for_ready": true,
    "evidence_references_required_for_ready": true,
    "structured_dependency_ids_required": true,
    "required_fields": [
      "source_repository",
      "exact_git_sha_or_waiting_merge",
      "source_pr_or_issue_if_applicable",
      "target_alias",
      "execution_location_class",
      "repository_entrypoint",
      "expected_baseline_when_observable",
      "read_only_preflight",
      "verification_and_reconciliation",
      "allowed_mutation_categories_and_limits",
      "explicit_exclusions",
      "dependencies_if_any",
      "deploy_class_and_extra_owner_gate_requirement"
    ],
    "forbidden_public_content": [
      "SECRETS",
      "TOKENS",
      "PASSWORDS",
      "PRIVATE_KEYS",
      "AUTHENTICATED_COOKIES_OR_STORAGE",
      "SERVICE_CREDENTIALS",
      "PROTECTED_CONFIGURATION",
      "UNREDACTED_SENSITIVE_LOGS"
    ]
  },
  "ready_rule": {
    "pr_ready_is_not_deploy_ready": true,
    "exact_merged_deployable_sha_required": true,
    "no_outstanding_source_work": true,
    "no_outstanding_separate_prerequisite_owner_gate": true,
    "execution_entrypoint_prepared": true,
    "preflight_and_verification_defined": true,
    "current_session_executor_availability_required_for_ready": false
  },
  "blocked_rule": {
    "valid_causes": [
      "APPROVED_SOURCE_SHA_NO_LONGER_INTENDED",
      "TARGET_OR_REQUIRED_BASELINE_CONFLICT",
      "DEPENDENCY_INCOMPLETE_OR_FAILED",
      "REQUIRED_CI_REVIEW_OR_POST_MERGE_EVIDENCE_INVALID",
      "REVIEWED_ENTRYPOINT_MISSING_OR_INCOMPATIBLY_CHANGED",
      "NEW_SEPARATELY_GATED_OR_UNDECLARED_MUTATION_CATEGORY_REQUIRED",
      "CANDIDATE_TARGET_OR_POLICY_DRIFT_MAKES_ROLLOUT_INELIGIBLE"
    ],
    "executor_unavailable_alone_is_blocked": false
  },
  "authorization": {
    "merge": {
      "explicit_owner_decision": true,
      "bind_latest_ready_receipt": true,
      "bind_expected_head_sha": true,
      "fresh_pre_mutation_revalidation": true,
      "authorization_does_not_follow_changed_head": true,
      "auto_merge": false
    },
    "cleanup": {
      "explicit_owner_decision": true,
      "strategy": "FORWARD_CORRECTIVE_COMMIT_ONLY",
      "bind_accidental_commit_and_expected_current_main": true,
      "allow_force": false,
      "allow_reset": false,
      "allow_rebase": false,
      "consumed_at_first_cleanup_write": true
    }
  },
  "live_all_execution": {
    "capability_check_before_freeze": true,
    "build_dependency_dag_before_freeze": true,
    "reject_dependency_cycles_before_mutation": true,
    "exclude_unordered_same_target_conflicts": true,
    "freeze_issue_numbers_and_declared_envelopes": true,
    "revalidate_before_each_first_live_mutation": true,
    "fail_closed_on_sha_target_or_baseline_drift": true,
    "ordinary_allowed_when_predeclared_and_project_allowed": [
      "TRUSTED_CHECKOUT_GIT_FETCH",
      "TRUSTED_CHECKOUT_GIT_MERGE_FF_ONLY",
      "PINNED_DETERMINISTIC_BUILD",
      "EXACT_APPLICATION_ARTIFACT_OR_VERSION_UPLOAD",
      "EXACT_APPLICATION_OR_WORKER_DEPLOYMENT_OR_PROMOTION",
      "MINIMUM_REVIEWED_SERVICE_OR_CONTAINER_RESTART_REQUIRED_BY_DEPLOYMENT",
      "READ_ONLY_CANDIDATE_VERIFICATION",
      "READ_ONLY_POST_DEPLOY_RECONCILIATION",
      "GITHUB_QUEUE_STATUS_AND_EVIDENCE_UPDATE"
    ],
    "never_implied": [
      "RESET",
      "REBASE",
      "CLEAN",
      "FORCE_OR_HISTORY_REWRITE",
      "AD_HOC_PACKAGE_REPAIR",
      "UNLISTED_RESTART",
      "UNLISTED_HOST_CHANGE",
      "ALTERNATE_DEPLOY_PATH"
    ]
  },
  "failure": {
    "batch_authorization_consumed_at_first_batch_mutation": true,
    "pre_mutation_rollout_eligibility_failure": "MARK_BLOCKED_AND_ONLY_CONTINUE_INDEPENDENT_NON_OVERLAPPING_ITEMS",
    "pre_snapshot_executor_unavailable": "LEAVE_READY_REPORT_PARKED_NOT_SELECTED",
    "post_mutation_error_or_ambiguity": "PRESERVE_EVIDENCE_MARK_STOP_ERROR_AND_STOP_REMAINING_BATCH",
    "automatic_retry": false,
    "automatic_rollback": false,
    "automatic_cleanup": false,
    "alternate_mutation_path": false
  },
  "completion": {
    "require_declared_reconciliation": true,
    "require_exact_observed_identity_when_platform_exposes_it": true,
    "append_final_issue_receipt": true,
    "record_mutation_counts": true,
    "close_successful_issue": true,
    "successful_issue_terminal_outcome": "DONE"
  },
  "operator_ux": {
    "action_required_only_for_real_current_owner_decision": true,
    "ready_deferred_live_work_default_message": "PARKED_NO_ACTION_REQUIRED_NOW",
    "live_all_is_not_mandatory_immediate_next_action": true
  }
}
