{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rozkalnsandris/ops-workflows/policy/schemas/auto-run-full-queue-authorization-v1.schema.json",
  "title": "AUTO-RUN FULL Queue authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "queue_id",
    "repository",
    "repository_id",
    "owner_user_id",
    "shared_contract_sha",
    "activation_main_sha",
    "consumer_rules_digest_sha256",
    "scope_digest_algorithm",
    "authority",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "rozkalns.auto-run-full-queue-auth.v1"
    },
    "queue_id": {
      "type": "string",
      "format": "uuid"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1
    },
    "owner_user_id": {
      "type": "integer",
      "minimum": 1
    },
    "shared_contract_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "activation_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "consumer_rules_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_digest_algorithm": {
      "const": "CANONICAL_JSON_REPOSITORY_ISSUE_NUMBER_TITLE_BODY_V1_SHA256"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "merge", "live"],
      "properties": {
        "source": {"const": true},
        "merge": {"const": true},
        "live": {"const": false}
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "node_id", "scope_digest_sha256"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scope_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
