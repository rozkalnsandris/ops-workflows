{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rozkalnsandris/ops-workflows/policy/schemas/auto-run-full-queue-controller-state-v1.schema.json",
  "title": "AUTO-RUN FULL Queue controller state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "queue_id",
    "frozen_issues",
    "cursor",
    "state",
    "active_issue",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "rozkalns.auto-run-full-queue-controller-state.v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "queue_id": {
      "type": "string",
      "format": "uuid"
    },
    "frozen_issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "READY",
        "ACTIVE",
        "PAUSED",
        "QUEUE_SOURCE_COMPLETE",
        "STOPPED"
      ]
    },
    "active_issue": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "terminalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_number",
        "merged_head_sha",
        "exact_main_sha",
        "exact_main_ci"
      ],
      "properties": {
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "merged_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "exact_main_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "exact_main_ci": {
          "const": "PASS"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "state", "terminal_evidence"],
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["PENDING", "ACTIVE", "SOURCE_COMPLETE", "STOPPED"]
        },
        "terminal_evidence": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/terminalEvidence"}
          ]
        }
      }
    }
  }
}
