{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rozkalnsandris/ops-workflows/blob/main/policy/schemas/live-auth-v1.schema.json",
  "title": "Rozkalns LIVE-AUTH v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "queue_repository",
    "queue_issue",
    "source_repository",
    "source_sha",
    "target_alias",
    "operation_id",
    "expected_baseline",
    "mutation_budget",
    "rollback_policy",
    "exclusions",
    "dependencies"
  ],
  "properties": {
    "schema": {"const": "rozkalns.live-auth.v1"},
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "queue_repository": {"const": "rozkalnsandris/ops-workflows"},
    "queue_issue": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "source_repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 201,
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
    },
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "expected_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "value": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "mutation_budget": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "max_operations"],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "max_operations": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    },
    "rollback_policy": {"enum": ["NONE", "BUILTIN_TRANSACTIONAL_V1"]},
    "exclusions": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
