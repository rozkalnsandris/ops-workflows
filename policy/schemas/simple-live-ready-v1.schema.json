{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rozkalnsandris/ops-workflows/policy/schemas/simple-live-ready-v1.schema.json",
  "title": "Simple LIVE ready envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "classification",
    "queue_id",
    "source_repository",
    "source_sha",
    "target_alias",
    "operation_id",
    "operation_contract_digest_sha256",
    "consumer_rules_digest_sha256",
    "shared_contract_sha",
    "expected_baseline",
    "read_only_preflight_digest_sha256",
    "allowed_mutation_classes",
    "maximum_total_mutations",
    "exclusions"
  ],
  "properties": {
    "schema": {
      "const": "rozkalns.simple-live-ready.v1"
    },
    "classification": {
      "const": "OWNER_LIVE_REQUIRED"
    },
    "queue_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "operation_contract_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "consumer_rules_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shared_contract_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["EXACT_SHA", "VERSION_ID", "DEPLOYMENT_ID", "HOST_STATE", "OTHER", "UNAVAILABLE"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "unavailable_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "UNAVAILABLE"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["unavailable_reason"]
          },
          "else": {
            "not": {
              "required": ["unavailable_reason"]
            }
          }
        }
      ]
    },
    "read_only_preflight_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "allowed_mutation_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      }
    },
    "maximum_total_mutations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
